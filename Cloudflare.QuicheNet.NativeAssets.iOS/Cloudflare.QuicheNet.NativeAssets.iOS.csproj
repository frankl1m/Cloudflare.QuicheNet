<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0-ios;net10.0-maccatalyst;net10.0-tvos</TargetFrameworks>
    <TargetFrameworks Condition="'$(EnableAppleLegacyTargets)' == 'true'">net8.0-ios;net8.0-maccatalyst;net8.0-tvos</TargetFrameworks>
    <TargetFrameworks Condition="'$(EnableAppleLegacy7Targets)' == 'true'">net7.0-ios;net7.0-maccatalyst;net7.0-tvos</TargetFrameworks>
    <SupportedOSPlatformVersion Condition="'$(TargetFramework)' == 'net7.0-ios' Or '$(TargetFramework)' == 'net7.0-tvos'">10.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="'$(TargetFramework)' == 'net7.0-maccatalyst'">13.1</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="'$(TargetFramework)' == 'net8.0-ios' Or '$(TargetFramework)' == 'net8.0-tvos'">12.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="'$(TargetFramework)' == 'net8.0-maccatalyst'">13.1</SupportedOSPlatformVersion>
    <IsPackable>true</IsPackable>
    <PackageId>Cloudflare.QuicheNet.NativeAssets.iOS</PackageId>
    <Description>Static quiche XCFramework for iOS/iPadOS devices, simulators, Mac Catalyst and tvOS (Intel and Apple Silicon simulators).</Description>
    <PackageLicenseExpression>BSD-2-Clause</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/frankl1m/Cloudflare.QuicheNet</RepositoryUrl>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <AppleQuicheFramework>$(MSBuildThisFileDirectory)Frameworks/quiche_bindgen.xcframework</AppleQuicheFramework>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="MinVer" Version="7.0.0" PrivateAssets="all" />
    <None Include="Frameworks/quiche_bindgen.xcframework/**/*" Pack="true" PackagePath="Frameworks/quiche_bindgen.xcframework/%(RecursiveDir)%(Filename)%(Extension)" />
    <None Include="buildTransitive/Cloudflare.QuicheNet.NativeAssets.iOS.targets" Pack="true" PackagePath="buildTransitive/" />
  </ItemGroup>
  <!-- P2P consumers need the same native reference as NuGet consumers. -->
  <Import Project="buildTransitive/Cloudflare.QuicheNet.NativeAssets.iOS.targets" />
  <Target Name="BuildAppleQuiche" BeforeTargets="PrepareForBuild" Condition="'$(BuildAppleQuicheNative)' == 'true'" >
    <Exec Command="bash &quot;$(MSBuildThisFileDirectory)../scripts/apple/build.sh&quot; all" />
  </Target>
  <Target Name="CollectAppleQuicheAssets" BeforeTargets="_GetPackageFiles" DependsOnTargets="BuildAppleQuiche">
    <ItemGroup>
      <None Remove="Frameworks/quiche_bindgen.xcframework/**" />
      <None Include="Frameworks/quiche_bindgen.xcframework/**/*" Pack="true"
            PackagePath="Frameworks/quiche_bindgen.xcframework/%(RecursiveDir)%(Filename)%(Extension)" />
    </ItemGroup>
  </Target>
  <Target Name="CheckAppleQuichePackage" BeforeTargets="GenerateNuspec" Condition="!Exists('$(AppleQuicheFramework)/Info.plist')">
    <Error Text="Build the Apple XCFramework first: scripts/apple/build.sh all" />
  </Target>
  <Target Name="VerifyAppleQuichePackage" BeforeTargets="GenerateNuspec" Condition="Exists('$(AppleQuicheFramework)/Info.plist')">
    <Exec Command="python3 &quot;$(MSBuildThisFileDirectory)../scripts/apple/verify.py&quot; &quot;$(AppleQuicheFramework)&quot;" />
  </Target>
</Project>
