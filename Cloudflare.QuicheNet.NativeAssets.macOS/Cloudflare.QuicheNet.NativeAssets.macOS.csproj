<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net7.0;net8.0;net10.0;net10.0-macos</TargetFrameworks>
		<RuntimeIdentifiers>osx-x64;osx-arm64</RuntimeIdentifiers>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<AllowUnsafeBlocks>True</AllowUnsafeBlocks>
		<OutputType>Library</OutputType>
	</PropertyGroup>

	<PropertyGroup>
		<IsPackable>true</IsPackable>
		<PackageId>Cloudflare.QuicheNet.NativeAssets.macOS</PackageId>
		<Company>Cloudflare Inc.</Company>
		<Description>A delicious C# wrapper for Cloudflare's quiche library</Description>
		<PackageTags>quiche;networking;bindings;native;wrapper;quic</PackageTags>
		<PackageLicenseExpression>BSD-2-Clause</PackageLicenseExpression>
		<RepositoryUrl>https://github.com/frankl1m/Cloudflare.QuicheNet</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<IncludeBuildOutput>false</IncludeBuildOutput>
	</PropertyGroup>


	<ItemGroup>
		<Compile Remove="runtimes/**" />
		<EmbeddedResource Remove="runtimes/**" />
		<None Remove="runtimes/**" />
	</ItemGroup>

	<PropertyGroup>
		<RustTargetTriple Condition="'$(RuntimeIdentifier)' == 'osx-x64'">x86_64-apple-darwin</RustTargetTriple>
		<RustTargetTriple Condition="'$(RuntimeIdentifier)' == 'osx-arm64'">aarch64-apple-darwin</RustTargetTriple>
		<RustLibraryFileName Condition="'$(RuntimeIdentifier)' == 'osx-x64'">libquiche_bindgen.dylib</RustLibraryFileName>
		<RustLibraryFileName Condition="'$(RuntimeIdentifier)' == 'osx-arm64'">libquiche_bindgen.dylib</RustLibraryFileName>
	</PropertyGroup>

	<ItemGroup>
		<RustTargetOutput Include="../quiche-bindgen/target/$(RustTargetTriple)/release/$(RustLibraryFileName)" />
		<NativeLibs Include="runtimes/**" />
		<None Include="@(NativeLibs)" PackagePath="runtimes/">
			<Pack>true</Pack>
			<PackageCopyToOutput>true</PackageCopyToOutput>
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="MinVer" Version="7.0.0">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
	</ItemGroup>

  <Target Name="BuildMacQuiche" BeforeTargets="PrepareForBuild" Condition="'$(BuildAppleQuicheNative)' == 'true'">
    <Exec Command="bash &quot;$(MSBuildThisFileDirectory)../scripts/macos/build.sh&quot; universal" />
  </Target>
  <Target Name="CollectMacQuicheAssets" BeforeTargets="_GetPackageFiles;GetCopyToOutputDirectoryItems" DependsOnTargets="BuildMacQuiche">
    <!-- Native builds may run after project evaluation, so refresh the glob. -->
    <ItemGroup>
      <None Remove="runtimes/**;$(MSBuildThisFileDirectory)runtimes/**" />
      <None Include="$(MSBuildThisFileDirectory)runtimes/**/*"
            Pack="true" PackagePath="runtimes/%(RecursiveDir)%(Filename)%(Extension)"
            Link="runtimes/%(RecursiveDir)%(Filename)%(Extension)"
            CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>
  <Target Name="CheckMacQuichePackage" BeforeTargets="GenerateNuspec"
          Condition="!Exists('$(MSBuildThisFileDirectory)runtimes/osx-x64/native/libquiche_bindgen.dylib') Or !Exists('$(MSBuildThisFileDirectory)runtimes/osx-arm64/native/libquiche_bindgen.dylib')">
    <Error Text="Build both macOS architectures first: scripts/macos/build.sh universal" />
  </Target>
</Project>
