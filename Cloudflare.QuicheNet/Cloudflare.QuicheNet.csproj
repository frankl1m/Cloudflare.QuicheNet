<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net7.0;net8.0;net10.0;net10.0-windows;net10.0-macos;net10.0-android;net10.0-ios;net10.0-maccatalyst;net10.0-tvos</TargetFrameworks>
		<TargetFrameworks Condition="'$(EnableAppleLegacyTargets)' == 'true'">net8.0-ios;net8.0-maccatalyst;net8.0-tvos</TargetFrameworks>
    <TargetFrameworks Condition="'$(EnableAppleLegacy7Targets)' == 'true'">net7.0-ios;net7.0-maccatalyst;net7.0-tvos</TargetFrameworks>
		<LangVersion>latest</LangVersion>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<AllowUnsafeBlocks>True</AllowUnsafeBlocks>
		<OutputType>Library</OutputType>
		<MinVerDefaultPreReleaseIdentifiers>preview.0</MinVerDefaultPreReleaseIdentifiers>
		<IsNuGetBuild>false</IsNuGetBuild>
	</PropertyGroup>


    <!-- Library availability is independent from the SDK surface (TargetPlatformVersion).
         .NET 10 application/runtime minima may be higher, especially Catalyst. -->
    <PropertyGroup>
      <SupportedOSPlatformVersion Condition="'$(TargetFramework)' == 'net7.0-ios' Or '$(TargetFramework)' == 'net7.0-tvos'">10.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="'$(TargetFramework)' == 'net7.0-maccatalyst'">13.1</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="'$(TargetFramework)' == 'net8.0-ios' Or '$(TargetFramework)' == 'net8.0-tvos'">12.0</SupportedOSPlatformVersion>
      <SupportedOSPlatformVersion Condition="'$(TargetFramework)' == 'net8.0-maccatalyst'">13.1</SupportedOSPlatformVersion>
      <SupportedOSPlatformVersion Condition="'$(TargetFramework)' == 'net10.0-ios'">12.2</SupportedOSPlatformVersion>
      <SupportedOSPlatformVersion Condition="'$(TargetFramework)' == 'net10.0-tvos'">12.2</SupportedOSPlatformVersion>
      <SupportedOSPlatformVersion Condition="'$(TargetFramework)' == 'net10.0-maccatalyst'">13.1</SupportedOSPlatformVersion>
    </PropertyGroup>

	<PropertyGroup>
		<IsPackable>true</IsPackable>
		<PackageId>Cloudflare.QuicheNet</PackageId>
		<Company>Cloudflare Inc.</Company>
		<Description>A delicious C# wrapper for Cloudflare's quiche library</Description>
		<PackageTags>quiche;networking;bindings;native;wrapper;quic</PackageTags>
		<PackageLicenseExpression>BSD-2-Clause</PackageLicenseExpression>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<RepositoryUrl>https://github.com/frankl1m/Cloudflare.QuicheNet</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
	</PropertyGroup>

	<ItemGroup>
		<None Include="../LICENSE.txt" Pack="true" PackagePath="/" />
		<None Include="../README.md" Pack="true" PackagePath="/" />
	</ItemGroup>

	<ItemGroup>
		<Compile Remove="NativeMethods.g.cs" />
		<Compile Include="NativeMethods.g.cs" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="MinVer" Version="7.0.0">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
	</ItemGroup>

	<ItemGroup Condition="'$(TargetFramework)' == 'net7.0' Or '$(TargetFramework)' == 'net8.0' Or '$(EnableAppleLegacyTargets)' == 'true' Or '$(EnableAppleLegacy7Targets)' == 'true'">
		<PackageReference Include="System.IO.Pipelines" Version="8.0.0" />
	</ItemGroup>

	<ItemGroup Condition="'$(BuildNativeAssets)' != 'false'">
		<ProjectReference Condition="'$(TargetFramework)' == 'net10.0' Or '$(TargetFramework)' == 'net8.0' Or '$(TargetFramework)' == 'net7.0'"
			Include="../Cloudflare.QuicheNet.NativeAssets.Linux/Cloudflare.QuicheNet.NativeAssets.Linux.csproj">
			<ReferenceOutputAssembly>$(IsNuGetBuild)</ReferenceOutputAssembly>
		</ProjectReference>
		<ProjectReference Condition="'$(TargetFramework)' == 'net10.0' Or '$(TargetFramework)' == 'net8.0' Or '$(TargetFramework)' == 'net7.0'"
			Include="../Cloudflare.QuicheNet.NativeAssets.macOS/Cloudflare.QuicheNet.NativeAssets.macOS.csproj">
			<ReferenceOutputAssembly>$(IsNuGetBuild)</ReferenceOutputAssembly>
		</ProjectReference>
		<ProjectReference Condition="'$(TargetFramework)' == 'net10.0' Or '$(TargetFramework)' == 'net8.0' Or '$(TargetFramework)' == 'net7.0'"
			Include="../Cloudflare.QuicheNet.NativeAssets.Win32/Cloudflare.QuicheNet.NativeAssets.Win32.csproj">
			<ReferenceOutputAssembly>$(IsNuGetBuild)</ReferenceOutputAssembly>
		</ProjectReference>
		<ProjectReference Condition="'$(TargetFramework)' == 'net10.0-windows'"
			Include="../Cloudflare.QuicheNet.NativeAssets.Win32/Cloudflare.QuicheNet.NativeAssets.Win32.csproj">
			<ReferenceOutputAssembly>$(IsNuGetBuild)</ReferenceOutputAssembly>
		</ProjectReference>
		<ProjectReference Condition="'$(TargetFramework)' == 'net10.0-macos'"
			Include="../Cloudflare.QuicheNet.NativeAssets.macOS/Cloudflare.QuicheNet.NativeAssets.macOS.csproj">
			<ReferenceOutputAssembly>$(IsNuGetBuild)</ReferenceOutputAssembly>
		</ProjectReference>
		<ProjectReference Condition="'$(TargetFramework)' == 'net10.0-android'"
			Include="../Cloudflare.QuicheNet.NativeAssets.Android/Cloudflare.QuicheNet.NativeAssets.Android.csproj">
			<ReferenceOutputAssembly>$(IsNuGetBuild)</ReferenceOutputAssembly>
		</ProjectReference>
		<ProjectReference Condition="'$(TargetFramework)' == 'net10.0-ios' Or '$(TargetFramework)' == 'net10.0-maccatalyst' Or '$(TargetFramework)' == 'net10.0-tvos' Or '$(EnableAppleLegacyTargets)' == 'true' Or '$(EnableAppleLegacy7Targets)' == 'true'"
			Include="../Cloudflare.QuicheNet.NativeAssets.iOS/Cloudflare.QuicheNet.NativeAssets.iOS.csproj">
			<ReferenceOutputAssembly>$(IsNuGetBuild)</ReferenceOutputAssembly>
		</ProjectReference>
	</ItemGroup>
</Project>