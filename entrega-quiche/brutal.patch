+//! Brutal congestion control.
+//!
+//! Brutal sends at a fixed rate configured by the application and never backs
+//! off on loss. Instead, it compensates for the observed ACK rate so that the
+//! goodput stays close to the configured rate. Until a rate is configured, all
+//! decisions are delegated to BBRv2.
+
+use std::time::Duration;
+use std::time::Instant;
+
+use super::bbr2::BBRv2;
+use super::Acked;
+use super::BbrParams;
+use super::CongestionControl;
+use super::Lost;
+use crate::recovery::gcongestion::Bandwidth;
+use crate::recovery::rtt::RttStats;
+use crate::recovery::RecoveryStats;
+
+/// Number of ACK rate sampling slots. Slots are indexed by seconds, so this is
+/// also the length of the sampling window in seconds.
+const PKT_INFO_SLOT_COUNT: usize = 5;
+
+/// Minimum number of acked and lost packets in the sampling window required to
+/// use the measured ACK rate.
+const MIN_SAMPLE_COUNT: u64 = 50;
+
+/// Lower bound of the ACK rate used to compensate for loss.
+const MIN_ACK_RATE: f64 = 0.8;
+
+const CONGESTION_WINDOW_MULTIPLIER: f64 = 2.0;
+
+/// Congestion window used until an RTT sample is available, in bytes.
+const NO_RTT_CONGESTION_WINDOW: usize = 10240;
+
+/// Minimum burst size, in packets.
+const MAX_BURST_PACKETS: usize = 10;
+
+/// Burst duration at the pacing rate (`maxBurstPacingDelayMultiplier` times
+/// `MinPacingDelay` in Hysteria).
+const MAX_BURST_PACING_DELAY: Duration = Duration::from_millis(4);
+
+#[derive(Clone, Copy, Debug, Default)]
+struct PktInfo {
+    timestamp: i64,
+    ack_count: u64,
+    loss_count: u64,
+}
+
+#[derive(Debug)]
+struct BrutalSender {
+    /// Configured send rate, in bytes per second.
+    bps: u64,
+
+    mss: usize,
+
+    pkt_info_slots: [PktInfo; PKT_INFO_SLOT_COUNT],
+
+    ack_rate: f64,
+
+    smoothed_rtt: Option<Duration>,
+
+    /// Reference point of the per-second slot timestamps.
+    epoch: Option<Instant>,
+}
+
+impl BrutalSender {
+    fn new(bps: u64, mss: usize, rtt_stats: &RttStats) -> Self {
+        BrutalSender {
+            bps,
+            mss,
+            pkt_info_slots: Default::default(),
+            ack_rate: 1.0,
+            smoothed_rtt: smoothed_rtt(rtt_stats),
+            epoch: None,
+        }
+    }
+
+    fn on_congestion_event(
+        &mut self, event_time: Instant, acked_packets: usize,
+        lost_packets: usize, rtt_stats: &RttStats,
+    ) {
+        if let Some(rtt) = smoothed_rtt(rtt_stats) {
+            self.smoothed_rtt = Some(rtt);
+        }
+
+        let epoch = *self.epoch.get_or_insert(event_time);
+        let current_timestamp =
+            event_time.saturating_duration_since(epoch).as_secs() as i64;
+
+        let slot = &mut self.pkt_info_slots
+            [current_timestamp as usize % PKT_INFO_SLOT_COUNT];
+
+        if slot.timestamp == current_timestamp {
+            slot.ack_count += acked_packets as u64;
+            slot.loss_count += lost_packets as u64;
+        } else {
+            // Uninitialized or too old slot, reset it.
+            *slot = PktInfo {
+                timestamp: current_timestamp,
+                ack_count: acked_packets as u64,
+                loss_count: lost_packets as u64,
+            };
+        }
+
+        self.update_ack_rate(current_timestamp);
+    }
+
+    fn update_ack_rate(&mut self, current_timestamp: i64) {
+        let min_timestamp = current_timestamp - PKT_INFO_SLOT_COUNT as i64;
+
+        let (ack_count, loss_count) = self
+            .pkt_info_slots
+            .iter()
+            .filter(|info| info.timestamp >= min_timestamp)
+            .fold((0, 0), |(ack, loss), info| {
+                (ack + info.ack_count, loss + info.loss_count)
+            });
+
+        if ack_count + loss_count < MIN_SAMPLE_COUNT {
+            self.ack_rate = 1.0;
+            return;
+        }
+
+        let rate = ack_count as f64 / (ack_count + loss_count) as f64;
+
+        self.ack_rate = rate.max(MIN_ACK_RATE);
+    }
+
+    fn congestion_window(&self) -> usize {
+        match self.smoothed_rtt {
+            Some(rtt) => {
+                let cwnd = self.bps as f64 *
+                    rtt.as_secs_f64() *
+                    CONGESTION_WINDOW_MULTIPLIER /
+                    self.ack_rate;
+
+                (cwnd as usize).max(self.mss)
+            },
+
+            None => NO_RTT_CONGESTION_WINDOW,
+        }
+    }
+
+    fn pacing_rate(&self) -> Bandwidth {
+        Bandwidth::from_bytes_per_second((self.bps as f64 / self.ack_rate) as u64)
+    }
+
+    fn max_burst_packets(&self) -> usize {
+        let burst = self
+            .pacing_rate()
+            .to_bytes_per_period(MAX_BURST_PACING_DELAY)
+            .max((MAX_BURST_PACKETS * self.mss) as u64);
+
+        burst.div_ceil(self.mss as u64) as usize
+    }
+}
+
+/// Returns the smoothed RTT, if a sample was taken.
+fn smoothed_rtt(rtt_stats: &RttStats) -> Option<Duration> {
+    if rtt_stats.has_first_rtt_sample && !rtt_stats.smoothed_rtt.is_zero() {
+        Some(rtt_stats.smoothed_rtt)
+    } else {
+        None
+    }
+}
+
+#[allow(clippy::large_enum_variant)]
+#[derive(Debug)]
+enum Mode {
+    /// No send rate is configured, BBRv2 is in charge.
+    Bbr(BBRv2),
+
+    /// A send rate is configured.
+    Brutal(BrutalSender),
+}
+
+#[derive(Debug)]
+pub(crate) struct Brutal {
+    mode: Mode,
+
+    mss: usize,
+
+    initial_congestion_window: usize,
+
+    max_congestion_window: usize,
+
+    initial_rtt: Duration,
+
+    custom_bbr_params: Option<BbrParams>,
+
+    time_sent_set_to_now: bool,
+}
+
+impl Brutal {
+    pub fn new(
+        initial_congestion_window: usize, max_congestion_window: usize,
+        max_segment_size: usize, initial_rtt: Duration,
+        custom_bbr_params: Option<&BbrParams>,
+    ) -> Self {
+        let bbr = BBRv2::new(
+            initial_congestion_window,
+            max_congestion_window,
+            max_segment_size,
+            initial_rtt,
+            custom_bbr_params,
+        );
+
+        Brutal {
+            time_sent_set_to_now: bbr.time_sent_set_to_now(),
+            mode: Mode::Bbr(bbr),
+            mss: max_segment_size,
+            initial_congestion_window,
+            max_congestion_window,
+            initial_rtt,
+            custom_bbr_params: custom_bbr_params.copied(),
+        }
+    }
+
+    pub fn time_sent_set_to_now(&self) -> bool {
+        self.time_sent_set_to_now
+    }
+
+    #[cfg(feature = "qlog")]
+    pub(crate) fn send_rate(&self) -> Option<Bandwidth> {
+        match &self.mode {
+            Mode::Bbr(bbr) => bbr.send_rate(),
+            Mode::Brutal(_) => None,
+        }
+    }
+
+    #[cfg(feature = "qlog")]
+    pub(crate) fn ack_rate(&self) -> Option<Bandwidth> {
+        match &self.mode {
+            Mode::Bbr(bbr) => bbr.ack_rate(),
+            Mode::Brutal(_) => None,
+        }
+    }
+
+    /// Sets the send rate, in bytes per second.
+    ///
+    /// A non-zero rate switches to Brutal and resets the ACK rate samples. A
+    /// rate of zero switches back to a new BBRv2 instance.
+    pub fn set_rate(&mut self, bytes_per_sec: u64, rtt_stats: &RttStats) {
+        if bytes_per_sec > 0 {
+            self.mode = Mode::Brutal(BrutalSender::new(
+                bytes_per_sec,
+                self.mss,
+                rtt_stats,
+            ));
+        } else if let Mode::Brutal(_) = self.mode {
+            self.mode = Mode::Bbr(BBRv2::new(
+                self.initial_congestion_window,
+                self.max_congestion_window,
+                self.mss,
+                self.initial_rtt,
+                self.custom_bbr_params.as_ref(),
+            ));
+        }
+    }
+}
+
+impl CongestionControl for Brutal {
+    #[cfg(feature = "qlog")]
+    fn state_str(&self) -> &'static str {
+        match &self.mode {
+            Mode::Bbr(bbr) => bbr.state_str(),
+            Mode::Brutal(_) => "brutal",
+        }
+    }
+
+    fn get_congestion_window(&self) -> usize {
+        match &self.mode {
+            Mode::Bbr(bbr) => bbr.get_congestion_window(),
+            Mode::Brutal(brutal) => brutal.congestion_window(),
+        }
+    }
+
+    fn get_congestion_window_in_packets(&self) -> usize {
+        match &self.mode {
+            Mode::Bbr(bbr) => bbr.get_congestion_window_in_packets(),
+            Mode::Brutal(brutal) => brutal.congestion_window() / brutal.mss,
+        }
+    }
+
+    fn can_send(&self, bytes_in_flight: usize) -> bool {
+        match &self.mode {
+            Mode::Bbr(bbr) => bbr.can_send(bytes_in_flight),
+            Mode::Brutal(brutal) => bytes_in_flight <= brutal.congestion_window(),
+        }
+    }
+
+    fn on_packet_sent(
+        &mut self, sent_time: Instant, bytes_in_flight: usize,
+        packet_number: u64, bytes: usize, is_retransmissible: bool,
+    ) {
+        if let Mode::Bbr(bbr) = &mut self.mode {
+            bbr.on_packet_sent(
+                sent_time,
+                bytes_in_flight,
+                packet_number,
+                bytes,
+                is_retransmissible,
+            );
+        }
+    }
+
+    fn on_packet_neutered(&mut self, packet_number: u64) {
+        if let Mode::Bbr(bbr) = &mut self.mode {
+            bbr.on_packet_neutered(packet_number);
+        }
+    }
+
+    fn on_congestion_event(
+        &mut self, rtt_updated: bool, prior_in_flight: usize,
+        bytes_in_flight: usize, event_time: Instant, acked_packets: &[Acked],
+        lost_packets: &[Lost], least_unacked: u64, rtt_stats: &RttStats,
+        recovery_stats: &mut RecoveryStats,
+    ) {
+        match &mut self.mode {
+            Mode::Bbr(bbr) => bbr.on_congestion_event(
+                rtt_updated,
+                prior_in_flight,
+                bytes_in_flight,
+                event_time,
+                acked_packets,
+                lost_packets,
+                least_unacked,
+                rtt_stats,
+                recovery_stats,
+            ),
+
+            // Loss never reduces the window, it only lowers the ACK rate.
+            Mode::Brutal(brutal) => brutal.on_congestion_event(
+                event_time,
+                acked_packets.len(),
+                lost_packets.len(),
+                rtt_stats,
+            ),
+        }
+    }
+
+    fn on_retransmission_timeout(&mut self, packets_retransmitted: bool) {
+        if let Mode::Bbr(bbr) = &mut self.mode {
+            bbr.on_retransmission_timeout(packets_retransmitted);
+        }
+    }
+
+    fn on_connection_migration(&mut self) {
+        if let Mode::Bbr(bbr) = &mut self.mode {
+            bbr.on_connection_migration();
+        }
+    }
+
+    fn limit_cwnd(&mut self, max_cwnd: usize) {
+        if let Mode::Bbr(bbr) = &mut self.mode {
+            bbr.limit_cwnd(max_cwnd);
+        }
+    }
+
+    fn is_in_recovery(&self) -> bool {
+        match &self.mode {
+            Mode::Bbr(bbr) => bbr.is_in_recovery(),
+            Mode::Brutal(_) => false,
+        }
+    }
+
+    fn is_cwnd_limited(&self, bytes_in_flight: usize) -> bool {
+        match &self.mode {
+            Mode::Bbr(bbr) => bbr.is_cwnd_limited(bytes_in_flight),
+            Mode::Brutal(brutal) => bytes_in_flight >= brutal.congestion_window(),
+        }
+    }
+
+    fn pacing_rate(
+        &self, bytes_in_flight: usize, rtt_stats: &RttStats,
+    ) -> Bandwidth {
+        match &self.mode {
+            Mode::Bbr(bbr) => bbr.pacing_rate(bytes_in_flight, rtt_stats),
+            Mode::Brutal(brutal) => brutal.pacing_rate(),
+        }
+    }
+
+    fn bandwidth_estimate(&self, rtt_stats: &RttStats) -> Bandwidth {
+        match &self.mode {
+            Mode::Bbr(bbr) => bbr.bandwidth_estimate(rtt_stats),
+            Mode::Brutal(brutal) => brutal.pacing_rate(),
+        }
+    }
+
+    fn max_bandwidth(&self) -> Bandwidth {
+        match &self.mode {
+            Mode::Bbr(bbr) => bbr.max_bandwidth(),
+            Mode::Brutal(brutal) => brutal.pacing_rate(),
+        }
+    }
+
+    fn update_mss(&mut self, new_mss: usize) {
+        self.mss = new_mss;
+
+        match &mut self.mode {
+            Mode::Bbr(bbr) => bbr.update_mss(new_mss),
+            Mode::Brutal(brutal) => brutal.mss = new_mss,
+        }
+    }
+
+    fn on_app_limited(&mut self, bytes_in_flight: usize) {
+        if let Mode::Bbr(bbr) = &mut self.mode {
+            bbr.on_app_limited(bytes_in_flight);
+        }
+    }
+
+    #[cfg(feature = "qlog")]
+    fn ssthresh(&self) -> Option<u64> {
+        match &self.mode {
+            Mode::Bbr(bbr) => bbr.ssthresh(),
+            Mode::Brutal(_) => None,
+        }
+    }
+
+    fn max_burst_packets(&self) -> Option<usize> {
+        match &self.mode {
+            Mode::Bbr(bbr) => bbr.max_burst_packets(),
+            Mode::Brutal(brutal) => Some(brutal.max_burst_packets()),
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    const MSS: usize = 1200;
+    const INITIAL_WINDOW_PACKETS: usize = 10;
+    const RATE: u64 = 1_000_000;
+    const RTT: Duration = Duration::from_millis(125);
+
+    fn new_brutal() -> Brutal {
+        Brutal::new(
+            INITIAL_WINDOW_PACKETS,
+            20_000,
+            MSS,
+            Duration::from_millis(333),
+            None,
+        )
+    }
+
+    fn rtt_stats(now: Instant) -> RttStats {
+        let mut rtt_stats =
+            RttStats::new(Duration::from_millis(333), Duration::from_millis(25));
+        rtt_stats.update_rtt(RTT, Duration::ZERO, now, true);
+        rtt_stats
+    }
+
+    fn congestion_event(
+        brutal: &mut Brutal, event_time: Instant, acked: usize, lost: usize,
+        rtt_stats: &RttStats,
+    ) {
+        let acked: Vec<Acked> = (0..acked)
+            .map(|i| Acked {
+                pkt_num: i as u64,
+                time_sent: event_time,
+            })
+            .collect();
+        let lost: Vec<Lost> = (0..lost)
+            .map(|i| Lost {
+                packet_number: i as u64,
+                bytes_lost: MSS,
+            })
+            .collect();
+
+        brutal.on_congestion_event(
+            true,
+            0,
+            0,
+            event_time,
+            &acked,
+            &lost,
+            0,
+            rtt_stats,
+            &mut RecoveryStats::default(),
+        );
+    }
+
+    fn ack_rate(brutal: &Brutal) -> f64 {
+        match &brutal.mode {
+            Mode::Brutal(brutal) => brutal.ack_rate,
+            Mode::Bbr(_) => panic!("not in Brutal mode"),
+        }
+    }
+
+    fn expected_cwnd(rate: u64, ack_rate: f64) -> usize {
+        (rate as f64 * RTT.as_secs_f64() * CONGESTION_WINDOW_MULTIPLIER /
+            ack_rate) as usize
+    }
+
+    #[test]
+    fn congestion_window() {
+        let now = Instant::now();
+        let mut brutal = new_brutal();
+
+        // Without an RTT sample.
+        let no_rtt =
+            RttStats::new(Duration::from_millis(333), Duration::from_millis(25));
+        brutal.set_rate(RATE, &no_rtt);
+        assert_eq!(brutal.get_congestion_window(), NO_RTT_CONGESTION_WINDOW);
+
+        let rtt_stats = rtt_stats(now);
+        congestion_event(&mut brutal, now, 1, 0, &rtt_stats);
+
+        // 1 MB/s * 125 ms * 2 / 1.0
+        assert_eq!(brutal.get_congestion_window(), 250_000);
+        assert_eq!(expected_cwnd(RATE, 1.0), 250_000);
+        assert_eq!(
+            brutal.get_congestion_window_in_packets(),
+            250_000 / MSS
+        );
+        assert!(brutal.can_send(250_000));
+        assert!(!brutal.can_send(250_001));
+
+        assert_eq!(
+            brutal.pacing_rate(0, &rtt_stats),
+            Bandwidth::from_bytes_per_second(RATE)
+        );
+
+        // The window never goes below one datagram.
+        brutal.set_rate(1, &rtt_stats);
+        assert_eq!(brutal.get_congestion_window(), MSS);
+    }
+
+    #[test]
+    fn ack_rate_floor() {
+        let now = Instant::now();
+        let rtt_stats = rtt_stats(now);
+        let mut brutal = new_brutal();
+        brutal.set_rate(RATE, &rtt_stats);
+
+        congestion_event(&mut brutal, now, 10, 90, &rtt_stats);
+
+        assert_eq!(ack_rate(&brutal), MIN_ACK_RATE);
+        assert_eq!(
+            brutal.get_congestion_window(),
+            expected_cwnd(RATE, MIN_ACK_RATE)
+        );
+        assert_eq!(
+            brutal.pacing_rate(0, &rtt_stats),
+            Bandwidth::from_bytes_per_second((RATE as f64 / MIN_ACK_RATE) as u64)
+        );
+
+        // Above the floor, the measured rate is used.
+        congestion_event(&mut brutal, now, 900, 0, &rtt_stats);
+        assert_eq!(ack_rate(&brutal), 910.0 / 1000.0);
+    }
+
+    #[test]
+    fn ack_rate_min_samples() {
+        let now = Instant::now();
+        let rtt_stats = rtt_stats(now);
+        let mut brutal = new_brutal();
+        brutal.set_rate(RATE, &rtt_stats);
+
+        congestion_event(&mut brutal, now, 10, 39, &rtt_stats);
+        assert_eq!(ack_rate(&brutal), 1.0);
+        assert_eq!(brutal.get_congestion_window(), expected_cwnd(RATE, 1.0));
+
+        // The 50th sample enables the measured rate.
+        congestion_event(&mut brutal, now, 0, 1, &rtt_stats);
+        assert_eq!(ack_rate(&brutal), MIN_ACK_RATE);
+    }
+
+    #[test]
+    fn ack_rate_window_expiry() {
+        let now = Instant::now();
+        let rtt_stats = rtt_stats(now);
+        let mut brutal = new_brutal();
+        brutal.set_rate(RATE, &rtt_stats);
+
+        // Sets the slot epoch.
+        congestion_event(&mut brutal, now, 0, 0, &rtt_stats);
+
+        let at = |secs| now + Duration::from_secs(secs);
+
+        congestion_event(&mut brutal, at(1), 10, 90, &rtt_stats);
+        assert_eq!(ack_rate(&brutal), MIN_ACK_RATE);
+
+        // Samples from second 1 are still within the window at second 5.
+        congestion_event(&mut brutal, at(5), 1, 0, &rtt_stats);
+        assert_eq!(ack_rate(&brutal), MIN_ACK_RATE);
+
+        // At second 7 they are older than the window.
+        congestion_event(&mut brutal, at(7), 1, 0, &rtt_stats);
+        assert_eq!(ack_rate(&brutal), 1.0);
+        assert_eq!(brutal.get_congestion_window(), expected_cwnd(RATE, 1.0));
+    }
+
+    #[test]
+    fn rate_changes() {
+        let now = Instant::now();
+        let rtt_stats = rtt_stats(now);
+        let mut brutal = new_brutal();
+
+        // Starts delegating to BBRv2.
+        assert!(matches!(brutal.mode, Mode::Bbr(_)));
+        assert_eq!(
+            brutal.get_congestion_window(),
+            INITIAL_WINDOW_PACKETS * MSS
+        );
+        assert_eq!(brutal.max_burst_packets(), None);
+
+        // Setting a rate switches to Brutal, seeding the smoothed RTT.
+        brutal.set_rate(RATE, &rtt_stats);
+        assert!(matches!(brutal.mode, Mode::Brutal(_)));
+        assert_eq!(brutal.get_congestion_window(), expected_cwnd(RATE, 1.0));
+
+        congestion_event(&mut brutal, now, 10, 90, &rtt_stats);
+        assert_eq!(ack_rate(&brutal), MIN_ACK_RATE);
+
+        // Changing the rate resets the samples.
+        brutal.set_rate(2 * RATE, &rtt_stats);
+        assert_eq!(ack_rate(&brutal), 1.0);
+        assert_eq!(
+            brutal.get_congestion_window(),
+            expected_cwnd(2 * RATE, 1.0)
+        );
+
+        congestion_event(&mut brutal, now, 0, 49, &rtt_stats);
+        assert_eq!(ack_rate(&brutal), 1.0);
+
+        // Going back to 0 creates a new BBRv2 instance.
+        brutal.set_rate(0, &rtt_stats);
+        assert!(matches!(brutal.mode, Mode::Bbr(_)));
+        assert_eq!(
+            brutal.get_congestion_window(),
+            INITIAL_WINDOW_PACKETS * MSS
+        );
+
+        brutal.set_rate(0, &rtt_stats);
+        assert!(matches!(brutal.mode, Mode::Bbr(_)));
+    }
+
+    #[test]
+    fn loss_does_not_reduce_window() {
+        let now = Instant::now();
+        let rtt_stats = rtt_stats(now);
+        let mut brutal = new_brutal();
+        brutal.set_rate(RATE, &rtt_stats);
+
+        let floor_cwnd = expected_cwnd(RATE, MIN_ACK_RATE);
+
+        for secs in 0..20 {
+            let event_time = now + Duration::from_secs(secs);
+
+            congestion_event(&mut brutal, event_time, 0, 1000, &rtt_stats);
+            brutal.on_retransmission_timeout(true);
+
+            assert_eq!(brutal.get_congestion_window(), floor_cwnd);
+            assert!(!brutal.is_in_recovery());
+            assert!(brutal.can_send(floor_cwnd));
+        }
+    }
+
+    #[test]
+    fn max_burst() {
+        let now = Instant::now();
+        let rtt_stats = rtt_stats(now);
+        let mut brutal = new_brutal();
+
+        // 4 ms at 1 MB/s is 4000 bytes, below 10 datagrams.
+        brutal.set_rate(RATE, &rtt_stats);
+        assert_eq!(brutal.max_burst_packets(), Some(MAX_BURST_PACKETS));
+
+        // 4 ms at 100 MB/s is 400000 bytes.
+        brutal.set_rate(100 * RATE, &rtt_stats);
+        assert_eq!(
+            brutal.max_burst_packets(),
+            Some(400_000_usize.div_ceil(MSS))
+        );
+
+        // The burst is based on the compensated pacing rate.
+        congestion_event(&mut brutal, now, 10, 90, &rtt_stats);
+        let pacing = (100 * RATE) as f64 / MIN_ACK_RATE;
+        let burst = Bandwidth::from_bytes_per_second(pacing as u64)
+            .to_bytes_per_period(MAX_BURST_PACING_DELAY);
+        assert_eq!(
+            brutal.max_burst_packets(),
+            Some(burst.div_ceil(MSS as u64) as usize)
+        );
+    }
+}
