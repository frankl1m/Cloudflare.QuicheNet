+    pub fn export_keying_material(
+        &self, label: &[u8], context: &[u8], out: &mut [u8],
+    ) -> Result<()> {
+        if !self.is_established() {
+            return Err(Error::InvalidState);
+        }
+
+        self.handshake.export_keying_material(label, context, out)
+    }
