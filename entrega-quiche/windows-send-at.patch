+/// Returns the current value of QueryPerformanceCounter, in nanoseconds.
+#[cfg(target_os = "windows")]
+fn performance_counter_nanos() -> u128 {
+    #[link(name = "kernel32")]
+    extern "system" {
+        fn QueryPerformanceCounter(count: *mut i64) -> i32;
+        fn QueryPerformanceFrequency(frequency: *mut i64) -> i32;
+    }
+
+    let mut count = 0;
+    let mut frequency = 0;
+
+    // These can't fail on Windows XP or later.
+    unsafe {
+        QueryPerformanceCounter(&mut count);
+        QueryPerformanceFrequency(&mut frequency);
+    }
+
+    let count = count.max(0) as u128;
+    let frequency = frequency.max(1) as u128;
+
+    count / frequency * 1_000_000_000 +
+        count % frequency * 1_000_000_000 / frequency
+}
+
+// Instant has no accessible epoch on Windows, so the time is expressed in the
+// QueryPerformanceCounter domain, the clock backing Instant, which other
+// runtimes can read as well (e.g. .NET's Stopwatch).
+#[cfg(target_os = "windows")]
+fn std_time_to_c(time: &Instant, out: &mut timespec) {
+    let now = Instant::now();
+    let now_nanos = performance_counter_nanos();
+
+    let nanos = if *time >= now {
+        now_nanos + time.duration_since(now).as_nanos()
+    } else {
+        now_nanos.saturating_sub(now.duration_since(*time).as_nanos())
+    };
+
+    out.tv_sec = (nanos / 1_000_000_000) as libc::time_t;
+    out.tv_nsec = (nanos % 1_000_000_000) as libc::c_long;
+}
