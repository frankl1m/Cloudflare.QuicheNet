 #[cfg(test)]
 mod tests {
     use super::*;
 
+    #[cfg(target_os = "windows")]
+    fn timespec_nanos(t: &timespec) -> u128 {
+        t.tv_sec as u128 * 1_000_000_000 + t.tv_nsec as u128
+    }
+
+    #[cfg(target_os = "windows")]
+    #[test]
+    fn time_to_c_windows() {
+        let now = Instant::now();
+        let delta = std::time::Duration::from_millis(5);
+
+        let mut out: timespec = unsafe { std::mem::zeroed() };
+
+        let before = performance_counter_nanos();
+        std_time_to_c(&now, &mut out);
+        let after = performance_counter_nanos();
+
+        let now_nanos = timespec_nanos(&out);
+        assert!(now_nanos > 0);
+        assert!(now_nanos <= after);
+        assert!(now_nanos + 1_000_000 >= before);
+
+        std_time_to_c(&(now + delta), &mut out);
+        let later_nanos = timespec_nanos(&out);
+        assert!(later_nanos.abs_diff(now_nanos + delta.as_nanos()) < 1_000_000);
+
+        std_time_to_c(&(now - delta), &mut out);
+        let earlier_nanos = timespec_nanos(&out);
+        assert!(earlier_nanos.abs_diff(now_nanos - delta.as_nanos()) < 1_000_000);
+    }
+
+    #[cfg(target_os = "windows")]
+    #[test]
+    fn send_info_at_windows() {
+        let mut pipe = crate::test_utils::Pipe::new("cubic").unwrap();
+        assert_eq!(pipe.handshake(), Ok(()));
+        assert_eq!(pipe.client.stream_send(0, b"hello", true), Ok(5));
+
+        let mut buf = [0; 1500];
+        let mut info: SendInfo = unsafe { std::mem::zeroed() };
+
+        let before = performance_counter_nanos();
+        let written = quiche_conn_send(
+            &mut pipe.client,
+            buf.as_mut_ptr(),
+            buf.len(),
+            &mut info,
+        );
+        let after = performance_counter_nanos();
+
+        assert!(written > 0);
+
+        // The release time is in the QueryPerformanceCounter domain, and at
+        // most slightly in the future because of pacing.
+        let at = timespec_nanos(&info.at);
+        assert!(at + 1_000_000 >= before);
+        assert!(at <= after + 100_000_000);
+    }
